{
  "name": "cigar-butt",
  "version": "0.1.0",
  "description": "MCP server for Graham/Schloss deep-value stock screening, computed from SEC EDGAR filings with disqualifier checks, allocation sizing, and rebalance planning.",
  "keywords": [
    "graham",
    "mcp",
    "model-context-protocol",
    "ncav",
    "net-net",
    "schloss",
    "sec-edgar",
    "stock-screener",
    "value-investing",
    "xbrl"
  ],
  "homepage": "https://github.com/mainfraame/cigar-butt#readme",
  "bugs": {
    "url": "https://github.com/mainfraame/cigar-butt/issues"
  },
  "license": "Apache-2.0",
  "author": "Dayne Mentier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mainfraame/cigar-butt.git"
  },
  "bin": {
    "cigar-butt": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip && pnpm test",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.3",
    "lodash-es": "^4.18.1",
    "node-html-parser": "^9.0.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.5.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,mts,cts,mjs,cjs,js}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.4.1"
}
